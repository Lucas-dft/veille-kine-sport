# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (reformulation/filtrage des résultats de recherche) ---
# Clé gratuite sans carte bancaire : https://aistudio.google.com/apikey
# Utilisée en texte seul (pas d'outil google_search, qui nécessite un
# prépaiement payant côté Gemini — voir README) : reste gratuite.
GEMINI_API_KEY=

# --- Brave Search (recherche web) ---
# Clé sur https://api-dashboard.search.brave.com — carte requise pour la
# vérification d'identité mais pas d'achat minimum imposé ; 5$/mois de
# crédit gratuit auto-appliqué (≈1000 requêtes/mois), largement suffisant
# ici (~20 requêtes/jour).
BRAVE_SEARCH_API_KEY=

# --- Resend (email quotidien) ---
RESEND_API_KEY=
# Expéditeur par défaut : onboarding@resend.dev ne peut envoyer qu'à l'adresse
# du propriétaire du compte Resend — parfait ici puisque USER_EMAIL doit être
# cette même adresse tant que vous n'avez pas vérifié un domaine.
RESEND_FROM=onboarding@resend.dev
USER_EMAIL=ldufiet.pro@gmail.com

# --- Sécurité ---
# Secret partagé pour protéger /api/cron/* (GitHub Actions + Vercel Cron).
CRON_SECRET=
# Mot de passe unique pour accéder au dashboard (mono-utilisateur).
APP_PASSWORD=

# --- Divers ---
# URL publique de l'app déployée (utilisée dans le lien de l'email et par le workflow GitHub Actions).
APP_URL=http://localhost:3000

# --- Gmail (optionnel — désactivé tant que ces 3 variables ne sont pas toutes renseignées) ---
# Lecture seule de lucas.kine.jobs@gmail.com via l'API Gmail officielle de Google
# (scope gmail.readonly). Voir lib/scrape/gmail.ts et le README pour la procédure
# de création de l'app OAuth dans Google Cloud Console.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
